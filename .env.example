# Copy this file to .env and fill in the values. Never commit .env.

# Port the game runs on (optional, default 3001)
# PORT=3001

# Public address shown in the QR code when the game runs behind a tunnel or on a server (optional)
# PUBLIC_URL=https://example.com

# --- AI question generator (optional; the game works without it) ---
# Easiest: paste the key in the game (✨ button) instead of editing this file.
# Google Gemini key (starts with AIza): https://aistudio.google.com/apikey
# or Groq key (starts with gsk_), if your network blocks Google's API: https://console.groq.com/keys
# The provider is detected from the key.
AI_API_KEY=
# Advanced: any OpenAI-compatible endpoint (e.g. OpenRouter)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=some/model
# AI_SOURCE_CHARS=8000   # article characters per language sent to the model
